import { Button, LineEdit, ListView, Palette } from "std-widgets.slint";
import { IdiomaDeLaInterfaz } from "idioma.slint";
import { CeldaConIcono, EncabezadoConIcono, Iconografia } from "iconografia.slint";

// Tema del catalogo que coincide con la busqueda.
export struct FichaDelCatalogo {
    titulo: string,
    artista: string,
    tipo: string,
    genero: string,
    album: string,
    anio: string,
    duracion: string,
    // BPM fijado o analizado (vacio si no se conoce).
    bpm: string,
    // Fecha y hora de la ultima reproduccion, en el formato elegido, o vacio.
    sonado: string,
    // Ruta del archivo, para el tooltip.
    ruta: string,
    // Ya esta en la lista de reproduccion.
    en-lista: bool,
    // El archivo ya no existe: no se puede insertar.
    sin-archivo: bool,
    seleccionada: bool,
}

// Celda de texto (con icono opcional) que se recorta con "..."; la fila
// muestra la ruta en un tooltip.
export component CeldaDelCatalogo inherits CeldaConIcono { }

// Buscador del catalogo: encuentra temas ya conocidos (por titulo, artista,
// genero, album o archivo) y los inserta en la lista.
export component BuscadorDelCatalogo inherits Window {
    title: @tr("Buscar en el catalogo - MCP Raptor Player");
    icon: @image-url("iconos/ventana-raptor.svg");
    preferred-width: 1240px;
    preferred-height: 680px;
    // Entran los seis botones de abajo.
    min-width: 1000px;
    min-height: 380px;
    background: Palette.background;

    in property <[FichaDelCatalogo]> fichas;
    in property <string> resumen;
    in property <string> aviso;
    in property <int> seleccionadas;
    in-out property <string> texto;

    callback buscar(texto: string);
    callback clic(indice: int, control: bool, mayusculas: bool);
    // Inserta esa ficha (doble clic) o, con -1, las seleccionadas.
    callback insertar(indice: int);
    callback agregar-al-final();
    // Actualizar los datos de los elegidos (o de todos los resultados).
    callback releer-etiquetas();
    callback completar-desde-internet();
    // Descarga las carátulas que faltan de los elegidos (o de todos).
    callback descargar-caratulas();
    callback cerrar();
    // Menu de un tema (indice): sobre uno elegido vale para todos los elegidos.
    callback editar(indice: int);
    // Origen: 0 releer las etiquetas, 1 completar desde internet.
    callback actualizar(indice: int, origen: int);
    callback descatalogar(indice: int);

    // El tema elegido (el del ultimo clic): su carátula y sus datos.
    in property <bool> hay-elegida;
    in property <string> elegida-titulo;
    in property <string> elegida-datos;
    // Clave del tipo, para el color de la carátula por defecto.
    in property <string> elegida-tipo;
    in property <image> caratula;
    in property <bool> hay-caratula;
    in property <string> origen-de-la-caratula;
    // La ampliada del globo, mientras el puntero esta sobre la carátula.
    in property <image> caratula-ampliada;
    property <bool> caratula-bajo-el-puntero;

    // Altura (en la ventana) donde empieza el globo de la carátula.
    property <length> lugar-del-globo;
    property <length> ancho-del-anio: 58px;
    property <length> ancho-de-la-duracion: 84px;
    // Entra "Publicidad" con su icono.
    property <length> ancho-del-tipo: 110px;
    property <length> ancho-del-genero: 116px;
    property <length> ancho-del-bpm: 58px;
    property <length> ancho-en-lista: 88px;
    // Entra "2026-11-23 14:05:33" (año-mes-dia lleva el año completo).
    property <length> ancho-de-sonado: 152px;

    pure function tono-de(ficha: FichaDelCatalogo) -> color {
        if ficha.seleccionada {
            return Palette.selection-foreground;
        }
        return ficha.sin-archivo ? Palette.foreground.transparentize(55%) : Palette.foreground;
    }

    public function enfocar() {
        campo.focus();
        campo.select-all();
    }

    forward-focus: campo;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            campo := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: @tr("Palabras, o prefijos como artista:sanz ranking:>=4 sonado:>30d (pase el puntero para ver todos)");
                text <=> root.texto;
                edited(texto) => { root.buscar(texto); }
                accepted => { root.insertar(-1); }
                Tooltip { text: IdiomaDeLaInterfaz.ingles ? @markdown("Without a prefix it searches all the words in title, artist, type, genre, album or file name, ignoring accents. With prefixes:\n\n- **artist:sanz**, **title:**, **genre:**, **album:**, **type:**, **note:**, **file:** (phrases in quotes: genre:\"rock nacional\")\n- **rating:>=4**, **year:1990..1999**, **bpm:120-128**, **duration:<3:30** (=, >, >=, <, <= or ranges)\n- **played:today**, **yesterday**, **never**, **7d** (last 7 days), **>30d** (more than 30 ago), **2026-11-03**, **<\{IdiomaDeLaInterfaz.ejemplo-de-fecha}**\n- A leading **-** negates: **-genre:cumbia**\n\nThe Spanish prefixes (artista:, titulo:, sonado:...) also work.") : @markdown("Sin prefijo busca todas las palabras en titulo, artista, tipo, genero, album o nombre de archivo, sin importar acentos. Con prefijos:\n\n- **artista:sanz**, **titulo:**, **genero:**, **album:**, **tipo:**, **nota:**, **archivo:** (frases entre comillas: genero:\"rock nacional\")\n- **ranking:>=4**, **anio:1990..1999**, **bpm:120-128**, **duracion:<3:30** (=, >, >=, <, <= o tramos)\n- **sonado:hoy**, **ayer**, **nunca**, **7d** (ultimos 7 dias), **>30d** (hace mas de 30), **2026-11-03**, **<\{IdiomaDeLaInterfaz.ejemplo-de-fecha}**\n- Un **-** adelante niega: **-genero:cumbia**"); }
                key-pressed(evento) => {
                    if evento.text == Key.Escape {
                        if self.text != "" {
                            self.text = "";
                            root.buscar("");
                        } else {
                            root.cerrar();
                        }
                        return accept;
                    }
                    return reject;
                }
            }
        }
        Text {
            text: root.resumen;
            font-size: 12px;
            color: Palette.foreground.transparentize(25%);
        }

        // El tema elegido: su carátula (o la R en el color del tipo) y datos.
        if root.hay-elegida: HorizontalLayout {
            height: 60px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                if root.hay-caratula: Image {
                    width: 56px;
                    height: 56px;
                    source: root.caratula;
                    image-fit: contain;
                    accessible-label: root.origen-de-la-caratula;
                    // Con el puntero encima se ve ampliada (el globo va al
                    // final de la ventana, por encima de la tabla).
                    TouchArea {
                        changed has-hover => {
                            root.caratula-bajo-el-puntero = self.has-hover;
                            root.lugar-del-globo = parent.absolute-position.y + parent.height + 4px;
                        }
                    }
                }
                if !root.hay-caratula: Rectangle {
                    property <color> tono: Iconografia.color-de-caratula(root.elegida-tipo);
                    width: 56px;
                    height: 56px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: self.tono.with-alpha(0.55);
                    background: self.tono.with-alpha(0.14);
                    accessible-role: image;
                    accessible-label: @tr("Sin carátula");
                    Image {
                        width: 32px;
                        height: 32px;
                        source: @image-url("iconos/ventana-raptor.svg");
                        colorize: parent.tono;
                    }
                    TouchArea { Tooltip { text: @markdown("\{@tr("Sin carátula")}"); } }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.elegida-titulo;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.elegida-datos;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(25%);
                    overflow: elide;
                }
            }
        }

        // Encabezado de la tabla.
        HorizontalLayout {
            height: 24px;
            padding-left: 1px;
            padding-right: 1px;
            EncabezadoConIcono { horizontal-stretch: 1; texto: @tr("Título"); icono: @image-url("iconos/dato-titulo.svg"); }
            EncabezadoConIcono { horizontal-stretch: 1; texto: @tr("Artista"); icono: @image-url("iconos/dato-artista.svg"); }
            EncabezadoConIcono { width: root.ancho-del-tipo; texto: @tr("Tipo"); icono: @image-url("iconos/dato-tipo.svg"); }
            EncabezadoConIcono { width: root.ancho-del-genero; texto: @tr("Género"); icono: @image-url("iconos/dato-genero.svg"); }
            EncabezadoConIcono { horizontal-stretch: 1; texto: @tr("Álbum"); icono: @image-url("iconos/dato-album.svg"); }
            EncabezadoConIcono { width: root.ancho-del-anio; texto: @tr("Año"); icono: @image-url("iconos/dato-anio.svg"); alineacion: right; }
            EncabezadoConIcono { width: root.ancho-de-la-duracion; texto: @tr("Duración"); icono: @image-url("iconos/dato-duracion.svg"); alineacion: right; }
            EncabezadoConIcono {
                width: root.ancho-del-bpm;
                texto: @tr("BPM");
                icono: @image-url("iconos/dato-bpm.svg");
                alineacion: right;
                ayuda: @tr("Tempo: el fijado en el editor o el que estimó el análisis (vacío si el tema todavía no se analizó). Se busca con bpm:, por ejemplo bpm:120..128");
            }
            EncabezadoConIcono {
                width: root.ancho-de-sonado;
                texto: @tr("Sonó");
                icono: @image-url("iconos/dato-sonado.svg");
                alineacion: right;
                ayuda: @tr("Fecha y hora en que empezó a sonar por última vez, en la hora de la localidad del HTH (vacío: nunca sonó). Se busca con sonado:, por ejemplo sonado:>30d");
            }
            EncabezadoConIcono {
                width: root.ancho-en-lista;
                texto: @tr("En lista");
                icono: @image-url("iconos/dato-en-lista.svg");
                alineacion: center;
                ayuda: @tr("Si el tema ya está en la lista de reproducción, o si falta su archivo");
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 4px;
            ListView {
                for ficha[indice] in root.fichas: Rectangle {
                    height: 28px;
                    background: ficha.seleccionada ? Palette.selection-background
                        : Math.mod(indice, 2) == 1 ? Palette.alternate-background : transparent;
                    // Sobre un tema elegido, vale para todos los elegidos.
                    menu-de-ficha := ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: @tr("Editar...");
                                enabled: !ficha.sin-archivo;
                                activated => { root.editar(indice); }
                            }
                            Menu {
                                title: @tr("Actualizar datos");
                                MenuItem {
                                    title: @tr("Completar desde internet...");
                                    activated => { root.actualizar(indice, 1); }
                                }
                                MenuItem {
                                    title: @tr("Releer las etiquetas...");
                                    activated => { root.actualizar(indice, 0); }
                                }
                            }
                            MenuItem {
                                title: @tr("Descatalogar...");
                                activated => { root.descatalogar(indice); }
                            }
                        }
                    }
                    TouchArea {
                        pointer-event(evento) => {
                            if evento.kind == PointerEventKind.down && evento.button == PointerEventButton.left {
                                root.clic(indice, evento.modifiers.control, evento.modifiers.shift);
                            }
                            // Clic derecho fuera de lo elegido: elige ese tema.
                            if evento.kind == PointerEventKind.down && evento.button == PointerEventButton.right {
                                if !ficha.seleccionada {
                                    root.clic(indice, false, false);
                                }
                                menu-de-ficha.show({ x: self.mouse-x, y: self.mouse-y });
                            }
                        }
                        double-clicked => { root.insertar(indice); }
                        HorizontalLayout {
                            CeldaDelCatalogo { horizontal-stretch: 1; texto: ficha.titulo; tono: root.tono-de(ficha); }
                            CeldaDelCatalogo { horizontal-stretch: 1; texto: ficha.artista; tono: root.tono-de(ficha); }
                            CeldaDelCatalogo {
                                width: root.ancho-del-tipo;
                                texto: Iconografia.nombre-de-tipo(ficha.tipo);
                                tono: root.tono-de(ficha);
                                icono: Iconografia.icono-de-tipo(ficha.tipo);
                                tono-del-icono: Iconografia.color-de-tipo(ficha.tipo, root.tono-de(ficha));
                            }
                            CeldaDelCatalogo { width: root.ancho-del-genero; texto: ficha.genero; tono: root.tono-de(ficha); }
                            CeldaDelCatalogo { horizontal-stretch: 1; texto: ficha.album; tono: root.tono-de(ficha); }
                            CeldaDelCatalogo { width: root.ancho-del-anio; texto: ficha.anio; tono: root.tono-de(ficha); alineacion: right; }
                            CeldaDelCatalogo { width: root.ancho-de-la-duracion; texto: ficha.duracion; tono: root.tono-de(ficha); alineacion: right; }
                            CeldaDelCatalogo { width: root.ancho-del-bpm; texto: ficha.bpm; tono: root.tono-de(ficha); alineacion: right; }
                            CeldaDelCatalogo { width: root.ancho-de-sonado; texto: ficha.sonado; tono: root.tono-de(ficha); alineacion: right; }
                            CeldaDelCatalogo {
                                width: root.ancho-en-lista;
                                texto: ficha.sin-archivo ? @tr("sin archivo") : ficha.en-lista ? @tr("si") : "";
                                tono: ficha.seleccionada ? Palette.selection-foreground
                                    : ficha.sin-archivo ? #ff8787 : #69db7c;
                                alineacion: center;
                            }
                        }
                        Tooltip { text: @markdown("\{ficha.ruta}"); }
                    }
                }
            }
            if root.fichas.length == 0: Text {
                text: root.texto == "" ? @tr("El catalogo esta vacio: los temas entran al agregarlos a la lista.") : @tr("Sin resultados.");
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Palette.foreground.transparentize(35%);
            }
        }

        Text {
            text: root.aviso != "" ? root.aviso
                : @tr("Clic, Ctrl+clic o Mayus+clic para elegir; doble clic o Enter inserta; clic derecho: editar, actualizar o descatalogar. Los que ya estan en la lista no se repiten.");
            wrap: word-wrap;
            font-size: 12px;
            color: Palette.foreground.transparentize(20%);
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                icon: @image-url("iconos/agregar.svg");
                colorize-icon: true;
                text: @tr("Insertar despues de la seleccionada ({})", root.seleccionadas);
                primary: true;
                enabled: root.seleccionadas > 0;
                clicked => { root.insertar(-1); }
                Tooltip { text: @markdown("\{@tr("Inserta los temas elegidos en la lista, despues de la pista seleccionada en la ventana principal (o al final si no hay)")}"); }
            }
            Button {
                icon: @image-url("iconos/bajar.svg");
                colorize-icon: true;
                text: @tr("Agregar al final");
                enabled: root.seleccionadas > 0;
                clicked => { root.agregar-al-final(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                icon: @image-url("iconos/deshacer.svg");
                colorize-icon: true;
                text: @tr("Releer etiquetas");
                enabled: root.fichas.length > 0;
                clicked => { root.releer-etiquetas(); }
                Tooltip { text: @markdown("\{@tr("Vuelve a leer las etiquetas de los archivos elegidos (o de todos los resultados, si no hay elegidos), por ejemplo despues de corregirlas con Picard, y muestra lo que cambiaria para elegirlo")}"); }
            }
            Button {
                icon: @image-url("iconos/buscar-en-catalogo.svg");
                colorize-icon: true;
                text: @tr("Internet");
                enabled: root.fichas.length > 0;
                clicked => { root.completar-desde-internet(); }
                Tooltip { text: @markdown("\{@tr("Busca los temas elegidos (o todos los resultados, si no hay elegidos) en internet (MusicBrainz, y lo que falte en Deezer e iTunes) y propone completar album, año, genero, titulo y artista")}"); }
            }
            Button {
                icon: @image-url("iconos/dato-album.svg");
                colorize-icon: true;
                text: @tr("Carátulas");
                enabled: root.fichas.length > 0;
                clicked => { root.descargar-caratulas(); }
                Tooltip { text: @markdown("\{@tr("Busca la carátula de los temas elegidos (o de todos los resultados, si no hay elegidos): los que tienen la suya, en el archivo o en su carpeta, no se consultan; las que faltan se descargan de internet (Deezer, iTunes y MusicBrainz) y quedan guardadas")}"); }
            }
            Button {
                icon: @image-url("iconos/cancelar.svg");
                colorize-icon: true;
                text: @tr("Cerrar");
                clicked => { root.cerrar(); }
            }
        }
    }

    // Globo de la carátula: ampliada y con su origen, mientras el puntero
    // esta sobre la del tema elegido. Va al final para quedar por encima de
    // la tabla y no toma el mouse.
    if root.caratula-bajo-el-puntero && root.hay-caratula && root.hay-elegida: Rectangle {
        x: 12px;
        y: min(root.lugar-del-globo, max(0px, root.height - self.height - 8px));
        width: globo-de-caratula.preferred-width;
        height: globo-de-caratula.preferred-height;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.border;
        background: Palette.background;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 3px;
        globo-de-caratula := VerticalLayout {
            padding: 8px;
            spacing: 6px;
            Image {
                width: 320px;
                height: 320px;
                source: root.caratula-ampliada;
                image-fit: contain;
            }
            Text {
                width: 320px;
                text: root.origen-de-la-caratula;
                font-size: 12px;
                color: Palette.foreground.transparentize(20%);
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}
