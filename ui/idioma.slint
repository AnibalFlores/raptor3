// Idioma de la interfaz para los pocos textos con formato (negritas, listas)
// que no pueden pasar por @tr(): se escriben en los dos idiomas y se elige
// con esta propiedad. Rust la fija en cada ventana al cambiar el idioma.
export global IdiomaDeLaInterfaz {
    in property <bool> ingles;
    // Una fecha de ejemplo en el formato elegido (menu Ventana), para las
    // ayudas de la busqueda: "01/10/2026", "10/01/2026" o "2026-10-01".
    in property <string> ejemplo-de-fecha: "01/10/2026";
}
