import { Button, CheckBox, ComboBox, LineEdit, ListView, SpinBox, Palette } from "std-widgets.slint";
import { CeldaConIcono as Celda, EncabezadoConIcono, Iconografia } from "iconografia.slint";
import { AvisoDeTanda } from "pauta.slint";

// Una orden de publicidad en la tabla.
export struct FilaDeOrden {
    nombre: string,
    anunciante: string,
    rubro: string,
    // "cada 2 h de 08:00 a 20:00, lun a vie".
    regla: string,
    // "2026-11-01 al 2026-11-30".
    vigencia: string,
    // "7 de 7" (ubicadas hoy de las que pide), "no rige hoy" o "vencida".
    hoy: string,
    activa: bool,
    problema: bool,
    seleccionada: bool,
}

// Una linea de la pauta de hoy.
export struct LineaDePauta {
    texto: string,
    problema: bool,
}


component Etiqueta inherits Text {
    vertical-alignment: center;
    horizontal-alignment: right;
}

// Ordenes de publicidad: lo que contrata cada anunciante y como se reparte
// hoy en las tandas programadas.
export component OrdenesDePublicidad inherits Window {
    title: @tr("Ordenes de publicidad - MCP Raptor Player");
    icon: @image-url("iconos/ventana-raptor.svg");
    preferred-width: 1240px;
    // Entra en Full HD al 150 % (unos 650 px logicos de alto utiles entre
    // la barra de titulo y la de tareas): los botones del final siempre se
    // ven. Con mas lugar crecen las listas.
    preferred-height: 640px;
    min-width: 1000px;
    min-height: 600px;
    background: Palette.background;

    in property <[FilaDeOrden]> ordenes;
    in property <[AvisoDeTanda]> avisos;
    in property <[LineaDePauta]> pauta-de-hoy;
    in property <string> resumen-de-hoy;
    in property <bool> editando;
    in property <bool> es-nueva;
    in property <bool> hay-aviso-elegido;
    in property <string> aviso;
    in property <bool> aviso-es-error;

    in-out property <string> nombre;
    in-out property <string> anunciante;
    in-out property <string> rubro;
    in-out property <string> desde;
    in-out property <string> hasta;
    in-out property <bool> lun;
    in-out property <bool> mar;
    in-out property <bool> mie;
    in-out property <bool> jue;
    in-out property <bool> vie;
    in-out property <bool> sab;
    in-out property <bool> dom;
    in-out property <string> franja-desde;
    in-out property <string> franja-hasta;
    // 0: cada N minutos; 1: N veces por dia; 2: a horas fijas.
    in-out property <int> tipo-de-frecuencia;
    in-out property <int> cantidad;
    in-out property <string> horarios;
    in-out property <string> tandas-permitidas;
    in-out property <int> prioridad;
    in-out property <bool> activa;
    in-out property <int> tipo-a-asignar;
    // Razon social y CUIT del anunciante, o la advertencia de que no tiene ficha.
    in property <string> estado-del-anunciante;
    in property <bool> anunciante-sin-ficha;

    callback elegir-orden(indice: int);
    callback alternar-activa(indice: int);
    callback nueva();
    callback quitar();
    callback certificado();
    callback guardar();
    callback descartar();
    callback agregar-avisos();
    callback elegir-aviso(indice: int);
    callback quitar-aviso();
    callback subir-aviso();
    callback bajar-aviso();
    callback asignar-tipo();
    callback cerrar();
    callback anunciante-editado(texto: string);
    callback ficha-del-anunciante();

    pure function tono-de(fila: FilaDeOrden) -> color {
        if fila.seleccionada {
            return Palette.selection-foreground;
        }
        return fila.activa ? Palette.foreground : Palette.foreground.transparentize(50%);
    }

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        Text {
            text: @tr("Cada orden pide salidas en su franja; se reparten solas en las tandas programadas (Pauta de tandas), sin pasar su duracion maxima ni juntar dos avisos del mismo rubro.");
            wrap: word-wrap;
            font-size: 12px;
            color: Palette.foreground.transparentize(25%);
        }

        HorizontalLayout {
            height: 24px;
            EncabezadoConIcono { width: 84px; texto: @tr("Activa"); icono: @image-url("iconos/dato-activa.svg"); ayuda: @tr("Una orden inactiva se conserva pero no reparte salidas"); }
            EncabezadoConIcono { width: 170px; texto: @tr("Orden"); icono: @image-url("iconos/dato-orden.svg"); }
            EncabezadoConIcono { width: 170px; texto: @tr("Anunciante"); icono: @image-url("iconos/dato-anunciante.svg"); }
            EncabezadoConIcono { width: 120px; texto: @tr("Rubro"); icono: @image-url("iconos/dato-rubro.svg"); }
            EncabezadoConIcono { horizontal-stretch: 1; texto: @tr("Salidas"); icono: @image-url("iconos/dato-salidas.svg"); }
            EncabezadoConIcono { width: 190px; texto: @tr("Vigencia"); icono: @image-url("iconos/dato-vigencia.svg"); }
            EncabezadoConIcono { width: 110px; texto: @tr("Hoy"); icono: @image-url("iconos/dato-hoy.svg"); ayuda: @tr("Salidas ubicadas hoy de las que pide la orden"); }
        }
        Rectangle {
            vertical-stretch: 1;
            min-height: 60px;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 4px;
            ListView {
                for fila[indice] in root.ordenes: Rectangle {
                    height: 30px;
                    background: fila.seleccionada ? Palette.selection-background
                        : Math.mod(indice, 2) == 1 ? Palette.alternate-background : transparent;
                    TouchArea {
                        clicked => { root.elegir-orden(indice); }
                        HorizontalLayout {
                            Rectangle {
                                width: 84px;
                                CheckBox {
                                    checked: fila.activa;
                                    toggled => { root.alternar-activa(indice); }
                                }
                            }
                            Celda { width: 170px; texto: fila.nombre; tono: root.tono-de(fila); peso: 600; }
                            Celda { width: 170px; texto: fila.anunciante; tono: root.tono-de(fila); }
                            Celda { width: 120px; texto: fila.rubro; tono: root.tono-de(fila); }
                            Celda { horizontal-stretch: 1; texto: fila.regla; tono: root.tono-de(fila); }
                            Celda { width: 190px; texto: fila.vigencia; tono: root.tono-de(fila); }
                            Celda {
                                width: 110px;
                                texto: fila.hoy;
                                tono: fila.seleccionada ? Palette.selection-foreground : fila.problema ? #ff8787 : root.tono-de(fila);
                            }
                        }
                    }
                }
            }
            if root.ordenes.length == 0: Text {
                text: @tr("No hay ordenes: use Nueva orden.");
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Palette.foreground.transparentize(35%);
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                icon: @image-url("iconos/agregar.svg");
                colorize-icon: true;
                text: @tr("Nueva orden");
                clicked => { root.nueva(); }
            }
            Button {
                icon: @image-url("iconos/quitar.svg");
                colorize-icon: true;
                text: @tr("Quitar orden");
                enabled: root.editando && !root.es-nueva;
                clicked => { root.quitar(); }
            }
            Button {
                icon: @image-url("iconos/validar.svg");
                colorize-icon: true;
                text: @tr("Certificado del mes");
                enabled: root.editando && !root.es-nueva;
                clicked => { root.certificado(); }
                Tooltip { text: @markdown("\{@tr("Arma el certificado de emision del anunciante (este mes hasta hoy) en un CSV y lo abre")}"); }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        Rectangle {
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 4px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding: 10px;
                spacing: 16px;

                GridLayout {
                    width: 500px;
                    spacing: 6px;
                    Row {
                        Etiqueta { text: @tr("Orden"); }
                        LineEdit { colspan: 3; text <=> root.nombre; placeholder-text: @tr("Sol - Noviembre"); enabled: root.editando; }
                    }
                    Row {
                        Etiqueta { text: @tr("Anunciante"); }
                        LineEdit {
                            text <=> root.anunciante;
                            placeholder-text: @tr("Supermercado Sol");
                            enabled: root.editando;
                            edited(texto) => { root.anunciante-editado(texto); }
                        }
                        Etiqueta { text: @tr("Rubro"); }
                        LineEdit { text <=> root.rubro; placeholder-text: @tr("Supermercados"); enabled: root.editando; }
                    }
                    Row {
                        Rectangle { }
                        Text {
                            colspan: 2;
                            text: root.estado-del-anunciante;
                            font-size: 12px;
                            overflow: elide;
                            vertical-alignment: center;
                            color: root.anunciante-sin-ficha ? #ffc078 : Palette.foreground.transparentize(30%);
                        }
                        Button {
                            text: @tr("Ficha...");
                            enabled: root.editando && root.anunciante != "";
                            clicked => { root.ficha-del-anunciante(); }
                            Tooltip { text: @markdown("\{@tr("Abre la ficha del anunciante (razon social, CUIT, contacto) o la crea")}"); }
                        }
                    }
                    Row {
                        Etiqueta { text: @tr("Desde"); }
                        LineEdit { text <=> root.desde; placeholder-text: @tr("AAAA-MM-DD"); enabled: root.editando; }
                        Etiqueta { text: @tr("Hasta"); }
                        LineEdit { text <=> root.hasta; placeholder-text: @tr("AAAA-MM-DD"); enabled: root.editando; }
                    }
                    Row {
                        Etiqueta { text: @tr("Días"); }
                        HorizontalLayout {
                            colspan: 3;
                            spacing: 2px;
                            CheckBox { text: @tr("Lun"); checked <=> root.lun; enabled: root.editando; }
                            CheckBox { text: @tr("Mar"); checked <=> root.mar; enabled: root.editando; }
                            CheckBox { text: @tr("Mie"); checked <=> root.mie; enabled: root.editando; }
                            CheckBox { text: @tr("Jue"); checked <=> root.jue; enabled: root.editando; }
                            CheckBox { text: @tr("Vie"); checked <=> root.vie; enabled: root.editando; }
                            CheckBox { text: @tr("Sab"); checked <=> root.sab; enabled: root.editando; }
                            CheckBox { text: @tr("Dom"); checked <=> root.dom; enabled: root.editando; }
                        }
                    }
                    Row {
                        Etiqueta { text: @tr("Franja de"); }
                        LineEdit { text <=> root.franja-desde; placeholder-text: "08:00"; enabled: root.editando; }
                        Etiqueta { text: "a"; }
                        LineEdit { text <=> root.franja-hasta; placeholder-text: "20:00"; enabled: root.editando; }
                    }
                    Row {
                        Etiqueta { text: @tr("Salidas"); }
                        ComboBox {
                            model: [@tr("Cada tantos minutos"), @tr("Veces por dia"), @tr("A horas fijas")];
                            current-index <=> root.tipo-de-frecuencia;
                            enabled: root.editando;
                        }
                        if root.tipo-de-frecuencia != 2: SpinBox {
                            colspan: 2;
                            minimum: root.tipo-de-frecuencia == 0 ? 5 : 1;
                            maximum: root.tipo-de-frecuencia == 0 ? 1440 : 96;
                            value <=> root.cantidad;
                            enabled: root.editando;
                        }
                        if root.tipo-de-frecuencia == 2: LineEdit {
                            colspan: 2;
                            text <=> root.horarios;
                            placeholder-text: "09:00, 13:30, 18:00";
                            enabled: root.editando;
                        }
                    }
                    Row {
                        Etiqueta { text: @tr("Solo en tandas"); }
                        LineEdit {
                            colspan: 3;
                            text <=> root.tandas-permitidas;
                            placeholder-text: @tr("vacio: en cualquiera (o nombres separados por coma)");
                            enabled: root.editando;
                        }
                    }
                    Row {
                        Etiqueta { text: @tr("Prioridad"); }
                        SpinBox { minimum: 1; maximum: 9; value <=> root.prioridad; enabled: root.editando; }
                        CheckBox { colspan: 2; text: @tr("Activa"); checked <=> root.activa; enabled: root.editando; }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    Text { text: @tr("Avisos (rotan: uno por salida)"); font-weight: 700; }
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 120px;
                        border-width: 1px;
                        border-color: Palette.border;
                        border-radius: 4px;
                        background: Palette.background;
                        ListView {
                            for aviso[indice] in root.avisos: Rectangle {
                                height: 26px;
                                background: aviso.seleccionado ? Palette.selection-background : transparent;
                                TouchArea {
                                    clicked => { root.elegir-aviso(indice); }
                                    HorizontalLayout {
                                        Celda {
                                            horizontal-stretch: 1;
                                            texto: (indice + 1) + ". " + aviso.nombre;
                                            tono: aviso.seleccionado ? Palette.selection-foreground : aviso.problema != "" ? #ff8787 : Palette.foreground;
                                        }
                                        Celda {
                                            width: 110px;
                                            texto: Iconografia.nombre-de-tipo(aviso.tipo);
                                            tono: aviso.seleccionado ? Palette.selection-foreground : Palette.foreground;
                                            icono: Iconografia.icono-de-tipo(aviso.tipo);
                                            tono-del-icono: Iconografia.color-de-tipo(aviso.tipo, self.tono);
                                        }
                                        Celda { width: 70px; texto: aviso.duracion; tono: aviso.seleccionado ? Palette.selection-foreground : Palette.foreground; }
                                    }
                                    Tooltip { text: @markdown("\{aviso.ruta}\{aviso.problema != "" ? "\n\n" + aviso.problema : ""}"); }
                                }
                            }
                        }
                        if root.avisos.length == 0: Text {
                            text: @tr("Agregue los avisos de la orden.");
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: Palette.foreground.transparentize(35%);
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            icon: @image-url("iconos/agregar.svg");
                            colorize-icon: true;
                            text: @tr("Agregar del catálogo...");
                            enabled: root.editando;
                            clicked => { root.agregar-avisos(); }
                            Tooltip { text: @markdown("\{@tr("Busca los avisos en el catalogo de la emisora (Comercial, Publicidad, Anuncio, Podcast o Seco); desde ahi tambien se asigna el tipo a los que no lo tienen o se agrega un archivo nuevo")}"); }
                        }
                        Button {
                            icon: @image-url("iconos/quitar.svg");
                            colorize-icon: true;
                            enabled: root.hay-aviso-elegido;
                            clicked => { root.quitar-aviso(); }
                        }
                        Button {
                            icon: @image-url("iconos/subir.svg");
                            colorize-icon: true;
                            enabled: root.hay-aviso-elegido;
                            clicked => { root.subir-aviso(); }
                        }
                        Button {
                            icon: @image-url("iconos/bajar.svg");
                            colorize-icon: true;
                            enabled: root.hay-aviso-elegido;
                            clicked => { root.bajar-aviso(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: @tr("Tipo del aviso elegido"); vertical-alignment: center; }
                        ComboBox {
                            width: 130px;
                            model: [@tr("Comercial"), @tr("Publicidad"), @tr("Anuncio"), @tr("Podcast")];
                            current-index <=> root.tipo-a-asignar;
                            enabled: root.hay-aviso-elegido;
                        }
                        Button {
                            text: @tr("Asignar tipo");
                            enabled: root.hay-aviso-elegido;
                            clicked => { root.asignar-tipo(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        // Pauta de hoy: donde va cada aviso y lo que no entro.
        HorizontalLayout {
            spacing: 8px;
            Text { text: @tr("Pauta de hoy"); font-weight: 700; }
            Text { text: root.resumen-de-hoy; color: #ff8787; }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            min-height: 40px;
            preferred-height: 120px;
            vertical-stretch: 1;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 4px;
            ListView {
                for linea in root.pauta-de-hoy: Text {
                    x: 8px;
                    height: 22px;
                    text: linea.texto;
                    vertical-alignment: center;
                    overflow: elide;
                    color: linea.problema ? #ff8787 : Palette.foreground;
                }
            }
            if root.pauta-de-hoy.length == 0: Text {
                text: @tr("Hoy no hay avisos de ordenes para repartir.");
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Palette.foreground.transparentize(35%);
            }
        }

        // Solo ocupa lugar cuando hay algo que avisar.
        if root.aviso != "": Text {
            text: root.aviso;
            wrap: word-wrap;
            font-size: 12px;
            color: root.aviso-es-error ? #ff8787 : Palette.foreground.transparentize(20%);
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                icon: @image-url("iconos/guardar.svg");
                colorize-icon: true;
                text: root.es-nueva ? @tr("Cargar orden") : @tr("Guardar cambios");
                primary: true;
                enabled: root.editando;
                clicked => { root.guardar(); }
            }
            Button {
                icon: @image-url("iconos/deshacer.svg");
                colorize-icon: true;
                text: @tr("Descartar cambios");
                enabled: root.editando;
                clicked => { root.descartar(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                icon: @image-url("iconos/cancelar.svg");
                colorize-icon: true;
                text: @tr("Cerrar");
                clicked => { root.cerrar(); }
            }
        }
    }
}
