import { AboutSlint, Button, Palette } from "std-widgets.slint";

// Ventana "Acerca de", con la imagen acerca_de.jpg de fondo (se incluye en
// el ejecutable al compilar). La imagen mide el doble que la ventana (1280 x
// 1400), para verse nitida hasta con la escala de Windows al 200 %.
export component AcercaDe inherits Window {
    title: @tr("Acerca de MCP Raptor Player");
    icon: @image-url("iconos/ventana-raptor.svg");
    // Entra en Full HD al 150 % (unos 690 px logicos de alto, con la barra
    // de tareas y la de titulo).
    width: 560px;
    height: 600px;
    background: #f2f0ec;

    in property <string> version;
    // Correo de contacto; con un clic se abre el programa de correo.
    in property <string> correo;
    // Direccion del repositorio; con un clic se abre en el navegador.
    in property <string> repositorio;
    callback cerrar();
    callback escribir-al-autor();
    callback abrir-repositorio();
    // Abre en el navegador la pagina de donaciones de PayPal.
    callback donar();

    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../acerca_de.jpg");
        image-fit: cover;
    }

    // Panel oscuro semitransparente para que el texto se lea sobre la imagen.
    Rectangle {
        x: 40px;
        y: parent.height - self.height - 24px;
        width: parent.width - 80px;
        height: contenido.preferred-height;
        border-radius: 10px;
        background: #101010.with-alpha(0.82);

        contenido := VerticalLayout {
            padding: 18px;
            spacing: 4px;
            alignment: center;

            Text {
                text: @tr("Raptor III");
                font-size: 40px;
                font-weight: 800;
                horizontal-alignment: center;
                color: Palette.accent-background;
            }
            Text {
                text: @tr("Edición 30 Aniversario");
                font-size: 20px;
                font-weight: 600;
                horizontal-alignment: center;
                color: #f5f5f5;
            }
            Text {
                text: "1997 - 2027";
                font-size: 16px;
                horizontal-alignment: center;
                color: #f5f5f5;
            }
            Text {
                text: @tr("por Aníbal H. Flores, «El Inyenieri»");
                font-size: 15px;
                horizontal-alignment: center;
                color: #f5f5f5;
            }
            Text {
                text: "MCP Raptor Player " + root.version;
                font-size: 12px;
                horizontal-alignment: center;
                color: #f5f5f5.with-alpha(0.65);
            }
            Rectangle { height: 4px; }
            Text {
                text: @tr("Software gratuito, sin garantía ni soporte. Se aceptan donaciones y sugerencias.");
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
                color: #f5f5f5.with-alpha(0.8);
            }
            Text {
                text: @tr("Iconos: Tabler Icons (licencia MIT).");
                font-size: 11px;
                horizontal-alignment: center;
                color: #f5f5f5.with-alpha(0.65);
            }
            // Atribucion de la biblioteca de la interfaz.
            HorizontalLayout {
                alignment: center;
                AboutSlint {
                    max-width: 160px;
                    max-height: 80px;
                }
            }
            // Contacto, repositorio y donaciones: cada boton abre el programa de
            // correo o el navegador; la direccion se ve en el globo de ayuda.
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Button {
                    text: @tr("Correo");
                    icon: @image-url("iconos/correo.svg");
                    colorize-icon: true;
                    accessible-description: @tr("Escribir a {}", root.correo);
                    clicked => { root.escribir-al-autor(); }
                    Tooltip { text: @markdown("\{@tr("Escribir a {}", root.correo)}"); }
                }
                Button {
                    text: "GitHub";
                    icon: @image-url("iconos/github.svg");
                    colorize-icon: true;
                    accessible-description: @tr("Abrir {} en el navegador", root.repositorio);
                    clicked => { root.abrir-repositorio(); }
                    Tooltip { text: @markdown("\{@tr("Abrir {} en el navegador", root.repositorio)}"); }
                }
                Button {
                    text: @tr("Donar con PayPal");
                    icon: @image-url("iconos/donar.svg");
                    colorize-icon: true;
                    clicked => { root.donar(); }
                }
            }
            HorizontalLayout {
                alignment: center;
                Button {
                    text: @tr("Cerrar");
                    primary: true;
                    clicked => { root.cerrar(); }
                }
            }
        }
    }
}
